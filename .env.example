# 复制为 .env 后修改。.env 不入库。
# 生成随机密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 生成凭证加密密钥：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phishguard

JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_KEY=change-me-to-a-fernet-key

# 首次启动时创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 工作台对外端口
WEB_PORT=8080

SYNC_INTERVAL_SECONDS=60
RAW_RETENTION_DAYS=30
OBSERVE_MODE_DEFAULT=true
